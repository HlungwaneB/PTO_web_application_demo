+/* ═══════════ Tracker (journey bar + timeline) - added, existing styles untouched ═══════════ */
+.pto-tr-journey { display: flex; gap: 4px; margin: 8px 0 4px; }
+.pto-tr-journey span { flex: 1; height: 6px; border-radius: 3px; background: #E4E4E4; }
+.pto-tr-journey span.on { background: #2E8B3A; }
+.pto-tr-journey span.now { background: #F26B1D; }
+.pto-tr-text { color: #F26B1D; font-size: 12px; font-weight: 600; margin-bottom: 16px; }
+.pto-tr-timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
+.pto-tr-timeline li { position: relative; padding-left: 26px; }
+.pto-tr-timeline li::before { content: ""; position: absolute; left: 0; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: #E0E0E0; }
+.pto-tr-timeline li.done::before { background: #2E8B3A; }
+.pto-tr-timeline li.now::before { background: #F26B1D; }
+.pto-tr-timeline li.bad::before { background: #C0392B; }
+.pto-tr-title { font-weight: 600; font-size: 14px; }
+.pto-tr-detail { color: #6F6F6F; font-size: 12px; }
+.pto-tr-timeline li.next .pto-tr-title { color: #6F6F6F; }
+.pto-tr-card { max-width: 760px; margin: 0 auto; }
