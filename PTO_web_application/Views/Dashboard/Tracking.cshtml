@{
    ViewData["Title"] = "PTO Tracking";
    Layout = "_DashboardLayout";

    var status = ViewBag.CurrentStatus as string ?? "Verifying";
    DateTime? startDate = ViewBag.StartDate;
    DateTime? endDate = ViewBag.EndDate;

    bool step1Done = true;
    bool step2Done = (status == "Verifying" || status == "Pending" || status == "Approved");
    bool step3Done = (status == "Pending" || status == "Approved");
    bool step4Done = (status == "Approved");

    // Inline style helpers
    string redDot = "width: 50px; height: 50px; border-radius: 50%; background-color: #E53935; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 15px auto;";
    string greyDot = "width: 50px; height: 50px; border-radius: 50%; background-color: #c4c4c4; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 15px auto;";
    string lineStyle = "height: 4px; background-color: #E53935; width: 100%;";
}

<div style="padding: 60px 80px; background-color: white; min-height: 75vh;">

    <h1 style="font-size: 38px; font-weight: 800; margin: 0 0 10px 0;">PTO Tracking</h1>
    <p style="font-size: 18px; margin: 0 0 60px 0;">Track your application</p>

    <!-- ═══════════ TRACKER (journey bar + timeline) ═══════════ -->
    <div class="pto-tr-card" style="margin: 0 auto 60px auto;">
        <partial name="_PtoTracker" model="new PTO_web_application.Models.ViewModels.PtoTrackerViewModel { Status = status, SubmittedOn = startDate, ValidUntil = endDate }" />
    </div>

    <!-- ═══════════ ACTION BUTTONS ═══════════ -->
    <div style="display: flex; justify-content: space-between; max-width: 1000px; margin: 0 auto;">
        <a href="/Dashboard" style="padding: 10px 30px; background: #a8a8a8; color: white; text-decoration: none; border-radius: 6px; font-size: 18px;">Back</a>
        <a href="/Dashboard" style="padding: 10px 30px; background: #a8a8a8; color: white; text-decoration: none; border-radius: 6px; font-size: 18px;">Done</a>
    </div>

</div>